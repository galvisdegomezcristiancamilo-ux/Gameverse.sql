/****** Object:  StoredProcedure [dbo].[sp_RegistrarPago]    Script Date: 6/10/2026 2:03:52 p. m. ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO


/* ============================================================
   PROCEDIMIENTO 3
   CRITERIO: PROCEDIMIENTO IN + OUTPUT

   Recibe:
   @id_reserva
   @valor_pago
   @metodo_pago

   Devuelve mediante OUTPUT:
   @id_pago

   Además registra el pago.
   ============================================================ */

CREATE PROCEDURE [dbo].[sp_RegistrarPago]
    @id_reserva INT,
    @valor_pago DECIMAL(10,2),
    @metodo_pago VARCHAR(30),
    @id_pago INT OUTPUT
AS
BEGIN

    SET NOCOUNT ON;

    /* Validar que exista la reserva */

    IF NOT EXISTS
    (
        SELECT 1
        FROM Reservas
        WHERE id_reserva = @id_reserva
    )
    BEGIN
        RAISERROR('La reserva no existe.', 16, 1);
        RETURN;
    END;


    /* Validar valor */

    IF @valor_pago <= 0
    BEGIN
        RAISERROR('El valor del pago debe ser mayor que cero.', 16, 1);
        RETURN;
    END;


    /* Registrar pago */

    INSERT INTO Pagos
    (
        id_reserva,
        valor_pago,
        metodo_pago
    )
    VALUES
    (
        @id_reserva,
        @valor_pago,
        @metodo_pago
    );


    /* Obtener ID generado */

    SET @id_pago = SCOPE_IDENTITY();


    /* Actualizar estado de la reserva
       cuando el total pagado cubra el valor */

    IF
    (
        SELECT ISNULL(SUM(valor_pago),0)
        FROM Pagos
        WHERE id_reserva = @id_reserva
    )
    >=
    (
        SELECT valor
        FROM Reservas
        WHERE id_reserva = @id_reserva
    )
    BEGIN

        UPDATE Reservas
        SET estado = 'Pagada'
        WHERE id_reserva = @id_reserva;

    END;

END;
