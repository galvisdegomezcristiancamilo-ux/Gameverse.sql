GO


/* ============================================================
   PROCEDIMIENTO 1
   CRITERIO: PROCEDIMIENTO CON PARÁMETRO DE ENTRADA (IN)

   Nombre solicitado por el examen:
   sp_BuscarReserva

   Recibe:
   @id_reserva

   Devuelve:
   Cliente
   Deporte
   Cancha
   Fecha
   Hora
   Valor
   ============================================================ */

CREATE PROCEDURE [dbo].[sp_BuscarReserva]
    @id_reserva INT
AS
BEGIN

    SET NOCOUNT ON;

    SELECT
        r.id_reserva,
        c.nombre AS Cliente,
        d.nombre AS Deporte,
        ca.nombre AS Cancha,
        r.fecha AS Fecha,
        r.hora AS Hora,
        r.valor AS Valor,
        r.estado AS Estado
    FROM Reservas r

    INNER JOIN Clientes c
        ON r.id_cliente = c.id_cliente

    INNER JOIN Canchas ca
        ON r.id_cancha = ca.id_cancha

    INNER JOIN Deportes d
        ON ca.id_deporte = d.id_deporte

    WHERE r.id_reserva = @id_reserva;

END;
