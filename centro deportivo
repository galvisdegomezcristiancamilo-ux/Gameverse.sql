/* ============================================================
   PROCEDIMIENTO 2
   CRITERIO: PROCEDIMIENTO CON OUTPUT

   Recibe un id de reserva y devuelve mediante OUTPUT
   el total pagado de dicha reserva.
   ============================================================ */

CREATE PROCEDURE [dbo].[sp_ObtenerTotalPagado]
    @id_reserva INT,
    @total_pagado DECIMAL(10,2) OUTPUT
AS
BEGIN

    SET NOCOUNT ON;

    SELECT
        @total_pagado = ISNULL(SUM(valor_pago), 0)
    FROM Pagos
    WHERE id_reserva = @id_reserva;

END;
