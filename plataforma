-- Reto 3 — Entrada + Salida: sp_CalcularRecaudoEvento
-- Recibe @id_evento y devuelve mediante OUTPUT el recaudo usando la fórmula especificada:
-- recaudo = participantes * precio del evento
CREATE PROCEDURE [dbo].[sp_CalcularRecaudoEvento]
    @id_evento INT,
    @recaudo DECIMAL(18,2) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    
    DECLARE @CantidadParticipantes INT;
    DECLARE @PrecioEvento DECIMAL(18,2);
    
    -- Obtener cantidad de inscritos al evento
    SELECT @CantidadParticipantes = COUNT(*) 
    FROM Inscripciones 
    WHERE id_evento = @id_evento;
    
    -- Obtener el precio unitario del evento
    SELECT @PrecioEvento = precio 
    FROM Eventos 
    WHERE id_evento = @id_evento;
    
    -- Aplicación estricta de la fórmula estipulada
    SET @recaudo = ISNULL(@CantidadParticipantes, 0) * ISNULL(@PrecioEvento, 0);
END;

