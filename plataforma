-- Reto 1 — Entrada: sp_BuscarEvento
-- Recibe @id_evento y muestra: nombre, fecha, hora, precio, lugar y categoría.
CREATE PROCEDURE [dbo].[sp_BuscarEvento]
    @id_evento INT
AS
BEGIN
    SET NOCOUNT ON;
    SELECT 
        e.nombre AS [nombre],
        e.fecha AS [fecha],
        e.hora AS [hora],
        e.precio AS [precio],
        l.nombre AS [lugar],
        c.nombre AS [categoría]
    FROM Eventos e
    INNER JOIN Lugares l ON e.id_lugar = l.id_lugar
    INNER JOIN Categorias c ON e.id_categoria = c.id_categoria
    WHERE e.id_evento = @id_evento;
END;

